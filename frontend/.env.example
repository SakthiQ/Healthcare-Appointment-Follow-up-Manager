# Base URL of the backend API.
# Leave empty in local dev — vite.config.ts proxies /api to the backend
# (override the proxy target with VITE_DEV_API_TARGET if the backend
# isn't on http://localhost:8000).
# In production set this to the deployed backend origin, e.g.
# VITE_API_BASE_URL="https://your-backend.onrender.com"
VITE_API_BASE_URL=""

# Dev-only: where vite should proxy /api to (default http://localhost:8000)
VITE_DEV_API_TARGET="http://localhost:8000"

# Keep the session in an httpOnly cookie instead of localStorage. Set to "true" ONLY if
# the API runs with AUTH_COOKIE_MODE=True AND the app and API share a site (e.g.
# app.example.com + api.example.com). Leave unset for a cross-site Vercel + Render setup.
# VITE_AUTH_COOKIES="true"
