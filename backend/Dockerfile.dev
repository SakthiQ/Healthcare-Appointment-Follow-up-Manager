# Local development image for compose.yaml. Production runs on Render without Docker.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependencies first, so editing code doesn't reinstall them. Same command as CI and Render.
COPY requirements.txt constraints.txt ./
RUN pip install -r requirements.txt -c constraints.txt

# compose.yaml mounts ./backend over this, so code changes reload without a rebuild.
COPY . .

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
