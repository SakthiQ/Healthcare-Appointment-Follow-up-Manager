# Healthcare Appointment & Follow-up Manager - Environment Configuration

# Application
PROJECT_NAME="Healthcare Appointment & Follow-up Manager"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# DEMO_MODE toggle (uses mock providers for external services)
DEMO_MODE=True

# Per-integration overrides (optional). Unset follows DEMO_MODE. For example,
# to use a real LLM while email and calendar stay mocked:
#   DEMO_MODE=True
#   AI_DEMO_MODE=False   (+ AI_PROVIDER_API_KEY below)
# AI_DEMO_MODE=
# EMAIL_DEMO_MODE=
# CALENDAR_DEMO_MODE=

# Database (PostgreSQL default, falls back to SQLite for testing if not reachable)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_db"

# Security (JWT secret key for Phase 3)
SECRET_KEY="dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SECURITY: must stay False in any real deployment. POST /auth/register only
# ever creates PATIENT accounts unless this is explicitly True. Only the test
# suite sets this (see backend/tests/conftest.py) to bootstrap admin/doctor
# fixtures. See README "Creating the first admin account" for the real
# bootstrap procedure.
ALLOW_PRIVILEGED_SELF_REGISTRATION=False

# Origins allowed to call this API cross-origin (comma-separated). Set to the
# deployed frontend's real origin(s) in production — never "*".
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Optional regex for extra allowed origins that can't be listed ahead of time,
# e.g. Vercel preview deployments: ^https://your-project-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEX=""

# LLM provider (Phase 7). Only used when AI demo mode is off: AI_DEMO_MODE when
# set, otherwise DEMO_MODE. MockAIProvider (AI demo mode on) needs none of this.
# Any OpenAI-compatible /chat/completions endpoint works.
AI_PROVIDER_API_KEY=""
AI_PROVIDER_BASE_URL="https://api.openai.com/v1"
AI_PROVIDER_MODEL="gpt-4o-mini"
AI_PROVIDER_TIMEOUT_SECONDS=15

# Email provider (Phase 9). Only used when email demo mode is off: EMAIL_DEMO_MODE
# when set, otherwise DEMO_MODE. MockEmailProvider needs none of this. Any SMTP-compatible provider works (SendGrid, Mailgun,
# Amazon SES, Gmail, etc. all support SMTP relay).
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=True
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS="no-reply@healthcare-app.local"

# Bounded retry attempts for a notification job before it is marked FAILED permanently.
NOTIFICATION_MAX_ATTEMPTS=5
# Minutes before a job left PROCESSING by a crashed worker is put back in the queue.
NOTIFICATION_PROCESSING_TIMEOUT_MINUTES=30

# Google Calendar + OAuth 2.0 (Phase 10). Only used when calendar demo mode is off:
# CALENDAR_DEMO_MODE when set, otherwise DEMO_MODE. MockCalendarProvider needs none of this. See README for how to obtain a
# refresh token via the OAuth consent flow. NEVER commit real values here.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_TOKEN_URI="https://oauth2.googleapis.com/token"
GOOGLE_CALENDAR_API_BASE_URL="https://www.googleapis.com/calendar/v3"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10

# Bounded retry attempts for a calendar sync before it is marked FAILED permanently.
CALENDAR_MAX_ATTEMPTS=5

# Run the notification + calendar workers on background threads inside the web
# process (needed on hosts with no separate worker process, e.g. the Render
# blueprint). Leave False if you run `python -m workers.notification_worker` and
# `python -m workers.calendar_worker` as their own processes.
RUN_WORKERS_IN_PROCESS=False
WORKER_POLL_INTERVAL_SECONDS=30

# Login throttling per (email, client IP): this many consecutive failures lock the pair
# out (HTTP 429) for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Cap on AI summaries generated per appointment and type (failures count).
AI_MAX_SUMMARIES_PER_APPOINTMENT=10

# Cookie sessions: keep the token in an httpOnly cookie (scripts can't read it) instead of
# having the frontend hold it in localStorage. Needs the frontend and API on the same site,
# and the frontend built with VITE_AUTH_COOKIES=true. Set AUTH_COOKIE_SECURE=False only for
# plain-http local development.
AUTH_COOKIE_MODE=False
AUTH_COOKIE_NAME=healthcare_session
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=lax

# Reject recording a consultation more than this many minutes before the appointment starts.
# Leave commented out for the demo flow (book a future slot, consult immediately).
# CONSULTATION_EARLY_SUBMIT_MINUTES=15

# Request limits (fixed one-hour windows kept in the database; HTTP 429 over the limit).
# RATE_LIMITING_ENABLED=False switches them all off.
RATE_LIMITING_ENABLED=True
REGISTER_RATE_LIMIT_PER_HOUR=10
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5
PASSWORD_RESET_EMAIL_RATE_LIMIT_PER_HOUR=3
AUTH_TOKEN_RATE_LIMIT_PER_HOUR=30
CHANGE_PASSWORD_RATE_LIMIT_PER_HOUR=10
AI_RATE_LIMIT_PER_HOUR=30

# Password-reset and email-verification links point at the frontend. SET THIS IN PRODUCTION.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Refuse login until the email address is verified. Leave False for the demo flow, and
# turn it on only once real email (SMTP) works.
REQUIRE_EMAIL_VERIFICATION=False
